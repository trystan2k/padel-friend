{
  "shadow": {
    "popover": {
      "$type": "shadow",
      "$value": "0 {space.4} {space.16} color-mix(in srgb, {color.text} 12%, transparent)"
    }
  },
  "focus": {
    "width": { "$type": "dimension", "$value": "{space.3}" },
    "offset": { "$type": "dimension", "$value": "{space.2}" }
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "{palette.bg}",
      "$extensions": { "theme": { "dark": "{palette.bg-dark}" } }
    },
    "surface": {
      "$type": "color",
      "$value": "{palette.surface}",
      "$extensions": { "theme": { "dark": "{palette.surface-dark}" } }
    },
    "surface-2": {
      "$type": "color",
      "$value": "{palette.surface-2}",
      "$extensions": { "theme": { "dark": "{palette.surface-2-dark}" } }
    },
    "text": {
      "$type": "color",
      "$value": "{palette.text}",
      "$extensions": { "theme": { "dark": "{palette.text-dark}" } }
    },
    "muted": {
      "$type": "color",
      "$value": "{palette.muted}",
      "$extensions": { "theme": { "dark": "{palette.muted-dark}" } }
    },
    "hairline": {
      "$type": "color",
      "$value": "{palette.hairline}",
      "$extensions": { "theme": { "dark": "{palette.hairline-dark}" } }
    },
    "line": {
      "$type": "color",
      "$value": "{palette.line}",
      "$extensions": { "theme": { "dark": "{palette.line-dark}" } }
    },
    "green": {
      "$type": "color",
      "$value": "{palette.green}",
      "$extensions": { "theme": { "dark": "{palette.green-dark}" } }
    },
    "on-green": {
      "$type": "color",
      "$value": "{palette.on-green}",
      "$extensions": { "theme": { "dark": "{palette.on-green-dark}" } }
    },
    "green-soft": {
      "$type": "color",
      "$value": "{palette.green-soft}",
      "$extensions": { "theme": { "dark": "{palette.green-soft-dark}" } }
    },
    "green-ink": {
      "$type": "color",
      "$value": "{palette.green-ink}",
      "$extensions": { "theme": { "dark": "{palette.green-ink-dark}" } }
    },
    "green-deep": { "$type": "color", "$value": "{palette.green-deep}" },
    "on-hero": { "$type": "color", "$value": "{palette.surface}" },
    "hero-copy": { "$type": "color", "$value": "{palette.hero-copy}" },
    "hero-muted": { "$type": "color", "$value": "{palette.hero-muted}" },
    "hero-label": { "$type": "color", "$value": "{palette.hero-label}" },
    "hero-accent": { "$type": "color", "$value": "{palette.hero-accent}" },
    "hero-divider": { "$type": "color", "$value": "{palette.hero-divider}" },
    "hero-avatar": { "$type": "color", "$value": "{palette.hero-avatar}" },
    "lime": { "$type": "color", "$value": "{palette.lime}" },
    "amber": {
      "$type": "color",
      "$value": "{palette.amber}",
      "$extensions": { "theme": { "dark": "{palette.amber-dark}" } }
    },
    "amber-soft": {
      "$type": "color",
      "$value": "{palette.amber-soft}",
      "$extensions": { "theme": { "dark": "{palette.amber-soft-dark}" } }
    },
    "red": {
      "$type": "color",
      "$value": "{palette.red}",
      "$extensions": { "theme": { "dark": "{palette.red-dark}" } }
    },
    "red-soft": {
      "$type": "color",
      "$value": "{palette.red-soft}",
      "$extensions": { "theme": { "dark": "{palette.red-soft-dark}" } }
    },
    "focus": { "$type": "color", "$value": "{palette.focus}" }
  }
}
