{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["design-tokens/style-dictionary.config.js", "src/routes/**/*.tsx"],
  "ignoreExportsUsedInFile": true,
  "ignore": [
    ".agents/**",
    ".opencode/plugins/**",
    "scripts/test-populated-migration-up.d.mts",
    "scripts/check-client-secrets.d.mts"
  ],
  "ignoreDependencies": ["@opencode/plugin"],
  "ignoreIssues": {
    "src/routes/**/*.{ts,tsx}": ["exports"],
    "src/lib/supabase/database.types.ts": ["types", "exports"],
    "src/i18n/config.ts": ["exports"]
  }
}
