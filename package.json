{
  "name": "padel-friend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm tokens:build",
    "dev": "vite dev",
    "prebuild": "pnpm tokens:build",
    "build": "vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "tokens:build": "style-dictionary build --config design-tokens/style-dictionary.config.js",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings && stylelint 'src/**/*.css'",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "node scripts/free-port.mjs 4173 && playwright test",
    "knip": "knip",
    "deps:audit": "pnpm audit",
    "deps:audit:json": "pnpm audit --json",
    "complete-check": "node scripts/complete-check.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "pnpm exec supabase gen types typescript --local --schema public,storage,graphql_public > src/lib/supabase/database.types.ts && pnpm exec oxfmt --write src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@base-ui/react": "~1.9.0",
    "@fontsource/inter": "~5.3.0",
    "@fontsource/manrope": "~5.3.0",
    "@stylexjs/stylex": "~0.19.1",
    "@supabase/ssr": "~0.12.7",
    "@supabase/supabase-js": "~2.117.3",
    "@tanstack/react-router": "~1.170.44",
    "@tanstack/react-start": "~1.169.2",
    "i18next": "~26.4.5",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~17.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "~1.64.0",
    "@commitlint/cli": "~21.2.3",
    "@commitlint/config-conventional": "~21.2.3",
    "@playwright/test": "~1.64.1",
    "@stylexjs/unplugin": "~0.19.1",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "@vitest/coverage-v8": "~5.0.4",
    "husky": "~9.1.7",
    "jsdom": "~30.1.2",
    "knip": "~6.41.0",
    "lint-staged": "~17.6.0",
    "oxfmt": "~0.73.0",
    "oxlint": "~1.88.0",
    "oxlint-tsgolint": "~7.0.2004",
    "playwright": "~1.64.1",
    "style-dictionary": "~5.6.1",
    "stylelint": "~17.16.0",
    "stylelint-config-standard": "~40.0.0",
    "supabase": "~2.121.0",
    "typescript": "~7.0.2",
    "vite": "~8.3.4",
    "vitest": "~5.0.4",
    "workbox-build": "~7.4.1",
    "wrangler": "~4.151.0"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.13.0"
}
