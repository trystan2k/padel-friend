VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key-from-supabase-status
# Optional public Cloudflare Turnstile site key; unset = captcha off (see INITIAL_SETUP.md section 11).
# VITE_TURNSTILE_SITE_KEY=

# Production release preflight (gitignored .env.production.local; owner only, INITIAL_SETUP.md section 4).
# Read by /release-preflight; never loaded into app builds you distribute.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
