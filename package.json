{
  "name": "padel-friend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm tokens:build",
    "dev": "vite dev",
    "prebuild": "pnpm tokens:build",
    "build": "vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "tokens:build": "style-dictionary build --config design-tokens/style-dictionary.config.js",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings && stylelint 'src/**/*.css'",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "complete-check": "pnpm build && pnpm knip && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public,storage,graphql_public > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@base-ui/react": "~1.7.0",
    "@fontsource/inter": "~5.3.0",
    "@fontsource/manrope": "~5.3.0",
    "@stylexjs/stylex": "~0.19.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/react-router": "~1.170.20",
    "@tanstack/react-start": "~1.168.37",
    "i18next": "~26.3.6",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-i18next": "~17.0.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@commitlint/cli": "~21.2.1",
    "@commitlint/config-conventional": "~21.2.0",
    "@playwright/test": "~1.62.0",
    "@stylexjs/unplugin": "~0.19.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.4",
    "@vitest/coverage-v8": "~4.1.10",
    "husky": "~9.1.7",
    "knip": "~6.29.0",
    "lint-staged": "~17.2.0",
    "oxfmt": "~0.61.0",
    "oxlint": "~1.76.0",
    "oxlint-tsgolint": "~7.0.2001",
    "playwright": "~1.62.0",
    "style-dictionary": "~5.5.0",
    "stylelint": "~17.14.1",
    "stylelint-config-standard": "~40.0.0",
    "supabase": "^2.0.0",
    "typescript": "~7.0.2",
    "vite": "~8.1.5",
    "vitest": "~4.1.10",
    "workbox-build": "~7.4.1",
    "wrangler": "~4.140.0"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.8"
  },
  "packageManager": "pnpm@11.0.8"
}
