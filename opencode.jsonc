{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "zai-coding-plan/glm-5.3-flash",
  "default_agent": "delivery-orchestrator",
  "experimental": {
    "todo": true
  },
  "mcp": {
    "servers": {
      "pencil": {
        "type": "local",
        "command": [
          "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
          "--app",
          "desktop"
        ],
        "disabled": false
      },
      "engram": {
        "type": "local",
        "command": ["/opt/homebrew/bin/engram", "mcp", "--tools=agent"],
        "disabled": false
      },
      "mcp_serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/oraios/serena",
          "serena",
          "start-mcp-server",
          "--enable-web-dashboard",
          "false",
          "--project-from-cwd",
          "--mode",
          "interactive",
          "--mode",
          "editing",
          "--mode",
          "no-memories"
        ],
        "disabled": false
      }
    }
  }
}
